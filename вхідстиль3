* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', sans-serif;
}

body {
    position: relative;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

body::before {
    content: "";
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('https://img.magnific.com/premium-photo/twilight-bloom-cactus-flowers-against-dusk-sky-cinco-de-mayo_1210791-918.jpg?semt=ais_hybrid&w=740&q=80');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    filter: blur(6px);
    transform: scale(1.1);
    z-index: -1;
}

/* Основна скляна картка */
.main-card {
    display: flex;
    width: 850px;
    height: 520px;
    background: rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 40px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.2);
    overflow: hidden;
    padding: 25px;
}

/* Внутрішня темніша панель */
.form-side {
    flex: 1.2;
    height: 100%;
    padding: 30px 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: rgba(30, 20, 45, 0.42);
    border-top-left-radius: 28px;
    border-bottom-left-radius: 28px;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-right: none;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
}

.image-side {
    flex: 1;
    height: 100%;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
}

.image-container {
    width: 100%;
    height: 100%;
    background-color: #fff;
    border-top-right-radius: 28px;
    border-bottom-right-radius: 28px;
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
    overflow: hidden;
    box-shadow: 10px 10px 30px rgba(0, 0, 0, 0.15);
}

.image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

h1 {
    color: #ffffff;
    font-size: 2rem;
    margin-bottom: 25px;
    text-align: center;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
}

.input-field {
    position: relative;
    margin-bottom: 20px;
    border-bottom: 2px solid rgba(255, 255, 255, 0.3);
    transition: border-color 0.3s ease;
}

.input-field label {
    display: block;
    font-size: 0.85rem;
    color: #f3e8ff;
    font-weight: 600;
}

.input-field input {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    padding: 8px 30px 8px 0;
    color: #ffffff;
    font-size: 1rem;
}

.input-field i {
    position: absolute;
    right: 5px;
    bottom: 10px;
    color: #ffb6c1;
}

/* Стиль для червоної підсвітки поля при помилці */
.input-field.error-input {
    border-bottom: 2px solid #ff4757 !important;
}

.input-field.error-input label {
    color: #ff6b81 !important;
}

.input-field.error-input i {
    color: #ff4757 !important;
}

.signup-btn {
    width: 100%;
    padding: 13px;
    border-radius: 50px;
    border: none;
    background: linear-gradient(135deg, #5c4a78, #3e3154);
    color: white;
    font-size: 1.05rem;
    font-weight: 600;
    cursor: pointer;
    margin-top: 10px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
    transition: all 0.3s ease;
}

.signup-btn:hover {
    background: linear-gradient(135deg, #6c548a, #4a3964);
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(255, 71, 87, 0.25);
}

.signup-btn:active {
    transform: translateY(0);
}

.footer-text {
    text-align: center;
    margin-top: 20px;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.8);
    font-weight: 500;
}

.error-text {
    display: none;
    color: #ff6b81;
    font-size: 12px;
    margin-top: -12px;
    margin-bottom: 10px;
    font-weight: 600;
}

.error-text.show {
    display: block;
}

.toggle-password {
    cursor: pointer;
}

.admin-btn {
    position: fixed;
    bottom: 20px;
    right: 20px;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #fff;
    padding: 10px 18px;
    border-radius: 30px;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    transition: all 0.3s ease;
    z-index: 1000;
    display: flex;
    align-items: center;
    gap: 8px;
}

.admin-btn:hover {
    background: rgba(255, 255, 255, 0.4);
    transform: translateY(-3px);
    color: #4a3a63;
}

/* Адаптивність для мобільних пристроїв */
@media (max-width: 800px) {
    .main-card {
        flex-direction: column;
        width: 90%;
        height: auto;
        margin-top: 20px;
        padding: 15px;
    }

    .form-side {
        border-radius: 20px;
    }

    .image-side {
        display: none;
    }
}