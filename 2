<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SLTh7 - Персональний Сайт</title>
  <link rel="stylesheet" href="style1.css">
  <style>
    /* Стилі для хеллоуїнського гарбузика внизу */
    .halloween-footer-surprise {
      text-align: center;
      padding: 40px 20px 20px 20px;
      margin-top: 40px;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    .pumpkin-btn {
      background: none;
      border: none;
      font-size: 55px;
      cursor: pointer;
      user-select: none;
      filter: drop-shadow(0 0 15px rgba(255, 107, 0, 0.4));
      transition: transform 0.3s ease;
      animation: pumpkinBounce 2s infinite ease-in-out;
    }

    .pumpkin-btn:hover {
      transform: scale(1.15) rotate(10deg);
    }

    .halloween-text {
      margin-top: 10px;
      font-size: 1.05rem;
      font-weight: 700;
      color: #ff9f43;
      opacity: 0;
      transform: translateY(-10px);
      transition: all 0.4s ease;
      pointer-events: none;
      text-shadow: 0 0 10px rgba(255, 159, 67, 0.5);
    }

    .halloween-text.show {
      opacity: 1;
      transform: translateY(0);
      animation: blinkText 1.5s infinite alternate;
    }

    @keyframes pumpkinBounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-6px); }
    }

    @keyframes blinkText {
      0% { opacity: 0.4; }
      100% { opacity: 1; }
    }
  </style>
</head>
<body>

  <!-- Напівпрозоре меню зверху -->
  <nav class="navbar">
    <div class="nav-container">
      <a href="#hero" class="nav-logo">
    <img src="https://cdn.discordapp.com/attachments/1549376815435485315/1549893053181853756/1789593681100.png?ex=6aad02a3&is=6aabb123&hm=d9aec3e3b814a9aa5d45c59f458fffaa4cc07ce6d3c16cce81463d8de960c7d1&" alt="SLTh7 Logo">
</a>
      <ul class="nav-links">
        <li><a href="index1.html">Головна</a></li>
        <li><a href="#hero">Огляд</a></li>
        <li><a href="#biography">Біографія</a></li>
        <li><a href="index2.html">Галерея фото</a></li>
        <li><a href="#gallery">Галерея творчості</a></li>
        <li><a href="#details">Детальна інформація</a></li>
      </ul>
    </div>
  </nav>

  <!-- 1. Головна секція на весь екран (Hero) -->
  <header class="hero" id="hero">
    <h1>Ласкаво просимо, Діано!</h1>
    <p></p>
    <a href="#gallery" class="btn">Дивитися галерею</a>
  </header>

  <!-- 2. Біографія -->
  <section class="content-section" id="biography">
    <h2 class="section-title">Біографія</h2>
    <div class="info-card">
      <p>Вітаємо на сайті! Тут розміщена коротка інформація про мене, мої проєкти та захоплення. Гортайте нижче, щоб переглянути відеогалерею.</p>
    </div>
  </section>

  <!-- 3. Відеогалерея (Одне вікно, 4 відео) -->
  <section class="content-section" id="gallery">
    <h2 class="section-title">Галерея творчих едітів</h2>

    <div class="video-slider-container">
      <!-- Стрілочки переключення -->
      <button class="nav-btn prev-btn" id="prevBtn" aria-label="Попереднє відео">&#10094;</button>
      <button class="nav-btn next-btn" id="nextBtn" aria-label="Наступне відео">&#10095;</button>

      <div class="video-player-wrapper">
  <video id="videoPlayer" controls allowfullscreen>
    <source src="" type="video/mp4">
  </video>
</div>

      <!-- Опис та лічильник -->
      <div class="video-info">
        <h3 id="videoTitle">Завантаження...</h3>
        <div class="video-counter" id="videoCounter">Відео 1 з 4</div>
      </div>
    </div>
  </section>

  <!-- 4. Детальна інформація -->
  <section class="content-section" id="details">
    <h2 class="section-title">Детальна інформація</h2>
    <div class="info-card">
      <p>У цьому розділі можна вказувати <a href="cake.html">додаткові</a> специфікації, посилання на портфоліо чи будь-які додаткові дані.</p>
    </div>
  </section>

  <!-- Хеллоуїнський сюрприз у самому низу сайту -->
  <div class="halloween-footer-surprise">
    <button class="pumpkin-btn" id="pumpkinBtn" title="Натисни мене!">🎃</button>
    <div class="halloween-text" id="halloweenText">ого а, що це таке? Нужмо, нажми!</div>
  </div>

  <script src="main.js"></script>
  <script>
    // Логіка кліків по гарбузику внизу
    const pumpkinBtn = document.getElementById('pumpkinBtn');
    const halloweenText = document.getElementById('halloweenText');
    let clickCount = 0;

    pumpkinBtn.addEventListener('click', () => {
      clickCount++;

      if (clickCount === 1) {
        // Перший клік: показуємо текст
        halloweenText.classList.add('show');
      } else {
        // Другий та наступні кліки: перекидаємо на іншу сторінку (наприклад, cake.html)
        window.location.href = 'cake.html'; 
      }
    });
  </script>
</body>
</html>